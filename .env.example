# Copia este archivo a .env y rellena los valores antes de ejecutar `docker compose up -d`.
# Nunca subas el archivo .env al repositorio.

# ---- PostgreSQL (datos de negocio + pgvector) ----
POSTGRES_DB=supportmind
POSTGRES_USER=supportmind
POSTGRES_PASSWORD=

# Rol propio del servicio de IA: solo tiene acceso al esquema vector_store (chunks y embeddings),
# nunca a las tablas de negocio. Se crea la primera vez que arranca el volumen de PostgreSQL.
VECTOR_DB_USER=supportmind_ai
VECTOR_DB_PASSWORD=

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Seguridad ----
# Secreto HMAC para firmar los JWT (mínimo 32 bytes). Genera uno con: openssl rand -base64 48
JWT_SECRET=

# ---- Servicio de IA (Python) ----
AI_SERVICE_URL=http://python-ai:8000
# Clave interna compartida entre Java y Python (mínimo 32 caracteres). Genera una con: openssl rand -hex 32
AI_SERVICE_API_KEY=

# ---- LLM ----
# Cualquier API compatible con OpenAI (OpenAI, Groq, OpenRouter, Ollama...). Si LLM_BASE_URL o LLM_MODEL
# quedan vacíos, el servicio de IA responde de forma extractiva con los fragmentos recuperados (sin LLM).
# Con el perfil "ollama" de docker compose: LLM_BASE_URL=http://ollama:11434/v1 y LLM_MODEL=qwen2.5:1.5b
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- Embeddings ----
# hash   -> embeddings locales por hashing de términos (sin modelo ni red; útil en desarrollo)
# openai -> API /embeddings compatible con OpenAI (OpenAI, Ollama...). Usa LLM_BASE_URL y LLM_API_KEY
#           salvo que se definan EMBEDDING_BASE_URL y EMBEDDING_API_KEY.
# Con el perfil "ollama": EMBEDDING_PROVIDER=openai y EMBEDDING_MODEL=paraphrase-multilingual (multilingüe,
# 768 dimensiones). Cambiar de modelo requiere reindexar la base de conocimiento.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-768
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Dimensiones del vector: deben coincidir con el modelo (paraphrase-multilingual y nomic-embed-text: 768)
EMBEDDING_DIMENSIONS=768

# ---- RAG ----
VECTOR_SEARCH_TOP_K=4
# Similitud mínima (coseno) para considerar relevante un fragmento. Vacío = valor por defecto del proveedor
# (hash: 0.10, openai: 0.35). Depende del modelo: mídelo con GET /api/v1/knowledge/search
RAG_MIN_SCORE=

# Confianza mínima de una respuesta de la IA; por debajo se deriva a un agente humano
# (valor por defecto de las organizaciones nuevas; cada organización puede cambiarlo)
AI_CONFIDENCE_THRESHOLD=0.55

# ---- Datos de demostración ----
# Crea la organización "Acme Store" con usuarios de cada rol y una base de conocimiento de ejemplo.
# Todos los usuarios de demo comparten la contraseña DEMO_USER_PASSWORD (mínimo 12 caracteres).
DEMO_DATA_ENABLED=false
DEMO_USER_PASSWORD=

# ---- Observabilidad ----
# Contraseña del usuario admin de Grafana (http://localhost:3007)
GRAFANA_ADMIN_PASSWORD=
